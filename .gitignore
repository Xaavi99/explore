# Generated build intermediates — regenerate with: python build/build_all.py
build/catalogue.json
build/images.json
build/logo.json

# Generated presentation decks — regenerate with: python build/deck.py <itinerary>
dist/

# NOTE: build/copy_cache.json is intentionally NOT ignored — it's the committed
# AI-copy cache that keeps deck rebuilds free and deterministic.

# Unused source videos (kept on disk, not tracked — build uses only .jpg)
*.mp4

# Python caches
__pycache__/
*.pyc

# OS / editor cruft
Thumbs.db
.DS_Store
*.tmp

# Claude Code local settings (per-user permission overrides, not shared)
.claude/settings.local.json
.claude/worktrees/
